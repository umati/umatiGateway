{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "OpcUa": {
      "Endpoint": "opc.tcp://localhost:4840/UA",
      "MachinesFolder": "Machines",
      "AutoConnect": true,
      "PublishingInterval": 500,
      "SamplingInterval": 250,
      "RescanInterval": 60
    },
    "Mqtt": {
      "Enabled": true,
      "Url": "mqtt://localhost:1883",
      "TopicPrefix": ""
    },
    "MachineIdSource": "ProductInstanceUri",
    "HeartbeatInterval": 10
  }
}
